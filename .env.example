# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# R.O.U.T.E. → Google Calendar
# Sincronizza impegni ed esami sul calendario e fa arrivare i reminder sul
# telefono. Genera il refresh token con: npm run google:auth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Calendario di destinazione: "primary" oppure l'id di un calendario dedicato
# (es. abc123@group.calendar.google.com). Consigliato un calendario separato.
GOOGLE_CALENDAR_ID="primary"

# Fuso orario usato per gli eventi (formato IANA).
GOOGLE_TIMEZONE="Europe/Rome"

# Metti a 1 per vedere nel log gli eventi che verrebbero creati, senza
# chiamare davvero Google (utile per provare la configurazione).
GOOGLE_CALENDAR_DRY_RUN="0"
